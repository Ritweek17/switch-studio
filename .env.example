# Copy to .env and fill in. Never commit .env.

# --- Run config (read by infra to build studio/run@1) ---
STUDIO_MODE=fixture                                   # fixture | live
STUDIO_REPO_PATH=fixtures/demo-repo                   # local git clone for live mode
STUDIO_SNAPSHOT_PATH=fixtures/demo-repo.snapshot.json # used in fixture mode
STUDIO_RANGE=HEAD~50..HEAD                            # git revision range
STUDIO_FORMAT=howiswitch                              # howiswitch | blog_section
STUDIO_RUNS_DIR=runs

# --- Switch room (M1 owns: confirm names in docs/SETUP.md) ---
SWITCH_BASE_URL=
SWITCH_TOKEN=
SWITCH_ROOM=#studio

# --- Agents (M2) ---
OPENAI_API_KEY=
